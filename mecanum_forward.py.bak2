            face_rot_start_time = novapi.timer()
            face_rot_settled = False
            pass
        if face_rotate_tick():
            face_show_until = novapi.timer() + FACE_SHOW_MS / 1000.0
            pass
        last_L1 = cur_L1
        __led.show('S%d' % BL_ACTION_SPEED)
