                last_Down = cur_Down
                last_Left = cur_Left
                last_Right = cur_Right
                last_N1 = cur_N1
                last_N2 = cur_N2
                last_N3 = cur_N3
                last_N4 = cur_N4
                last_L1_debug = cur_L1
                last_R1_debug = cur_R1
                last_Menu = cur_Menu
                time.sleep(LOOP_DELAY)
                continue
            cal_key_handled = False
            if _debug_cal_done:
                if cur_N1 and (not last_N1):
                    _show_cal_delta(1, _cal_delta_M1)
                    cal_key_handled = True
                if cur_N2 and (not last_N2):
                    _show_cal_delta(2, _cal_delta_M2)
                    cal_key_handled = True
                if cur_N3 and (not last_N3):
                    _show_cal_delta(3, _cal_delta_M3)
                    cal_key_handled = True
                if cur_N4 and (not last_N4):
                    _show_cal_delta(4, _cal_delta_M4)
                    cal_key_handled = True
            if cal_key_handled:
                last_Up = cur_Up
                last_Down = cur_Down
                last_Left = cur_Left
                last_Right = cur_Right
                last_N1 = cur_N1
                last_N2 = cur_N2
                last_N3 = cur_N3
                last_N4 = cur_N4
                last_L1_debug = cur_L1
                last_R1_debug = cur_R1
                last_Menu = cur_Menu
                time.sleep(LOOP_DELAY)
                continue
            if debug_cal_done_time > 0:
                if novapi.timer() - debug_cal_done_time < 2.0:
                    last_Up = cur_Up
                    last_Down = cur_Down
                    last_Left = cur_Left
                    last_Right = cur_Right
                    last_N1 = cur_N1
                    last_N2 = cur_N2
                    last_N3 = cur_N3
                    last_N4 = cur_N4
                    last_L1_debug = cur_L1
                    last_R1_debug = cur_R1
                    last_Menu = cur_Menu
                    time.sleep(LOOP_DELAY)
                    continue
                else:
                    debug_cal_done_time = 0.0
            if debug_cal_auto_start and novapi.timer() - debug_cal_auto_time >= 1.0:
                debug_cal_auto_start = False
                debug_cal_start(CAL_ANGLE)
                last_Up = cur_Up
                last_Down = cur_Down
                last_Left = cur_Left
                last_Right = cur_Right
                last_N1 = cur_N1
                last_N2 = cur_N2
                last_N3 = cur_N3
                last_N4 = cur_N4
                last_L1_debug = cur_L1
                last_R1_debug = cur_R1
                last_Menu = cur_Menu
                time.sleep(LOOP_DELAY)
                continue
            if cur_N1 and (not last_N1):
                debug_cal_auto_start = False
                debug_cal_start(CAL_ANGLE)
            if cur_L1 and cur_R1 and (not last_L1_debug or not last_R1_debug):
                debug_cal_mode = False
                debug_cal_running = False
                debug_cal_done_time = 0.0
                debug_cal_auto_start = False
                stop_all_motors()
                pass
                last_Up = last_Down = last_Left = last_Right = False
                last_N1 = last_N2 = last_N3 = last_N4 = False
                last_L1_debug = last_R1_debug = False
                last_Menu = cur_Menu
                time.sleep(0.3)
