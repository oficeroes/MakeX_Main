            cal_key_handled = True
        if cur_N3 and (not last_N3):
            _show_cal_delta(3, _cal_delta_M3)
            cal_key_handled = True
        if cur_N4 and (not last_N4):
            _show_cal_delta(4, _cal_delta_M4)
            cal_key_handled = True
    if cal_key_handled:
        last_R1 = cur_R1
        last_R2 = cur_R2
        last_L2 = cur_L2
        last_L1 = cur_L1
