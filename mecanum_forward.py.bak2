        if cur_Left and cur_Right:
            _dpad_lr_conflict += 1
        else:
            _dpad_lr_conflict = 0
        if _dpad_lr_conflict >= 3:
            cur_Left = False
            cur_Right = False
        if cur_Up and cur_Down:
            _dpad_ud_conflict += 1
        else:
            _dpad_ud_conflict = 0
        if _dpad_ud_conflict >= 3:
            cur_Up = False
