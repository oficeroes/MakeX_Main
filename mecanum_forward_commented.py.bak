                continue
            if debug_cal_done_time > 0:
                if novapi.timer() - debug_cal_done_time < 2.0:
                    last_Up = cur_Up
                    last_Down = cur_Down
                    last_Left = cur_Left
                    last_Right = cur_Right
                    last_N1 = cur_N1
                    last_N2 = cur_N2
                    last_N3 = cur_N3
                    last_N4 = cur_N4
                    last_L1_debug = cur_L1
