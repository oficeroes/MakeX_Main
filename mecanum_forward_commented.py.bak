__led.show("Main")
novapi.reset_timer()
while True:
    if auto_mode:
        if gamepad.is_key_pressed("N4") or gamepad.is_key_pressed("≡"):
            stop_all_motors()
            auto_mode = False
            auto_step = 0
            _enc_step_initialized = -1
            _enc_cal_auto_started = False
            __led.show("STOP")
            time.sleep(0.2)
            continue
        step = AUTO_SEQUENCE[auto_step]
        elapsed = novapi.timer() - auto_step_start
        if isinstance(step[0], str):
            tag = step[0]
            if tag == 'encoder_cal':
                _, cal_dur, cal_Vx, cal_Vy, cal_omega = step  # 5 元组
                if not _enc_cal_auto_started:
                    _reset_drive_encoder_reference("encoder_cal")
                    _starts = _read_motor_angles(_get_motors())
                    _enc_cal_M1_start = _starts[0]
                    _enc_cal_M2_start = _starts[1]
                    _enc_cal_M3_start = _starts[2]
                    auto_step_start = novapi.timer()
                    _enc_cal_auto_started = True
                    pass
                if elapsed >= cal_dur:
                    M1_end = __motor_M1.get_value("angle")
                    M2_end = __motor_M2.get_value("angle")
                    M3_end = __motor_M3.get_value("angle")
                    _cal_delta_M1 = M1_end - _enc_cal_M1_start
                    _cal_delta_M2 = M2_end - _enc_cal_M2_start
                    _cal_delta_M3 = M3_end - _enc_cal_M3_start
                    _cal_delta_M4 = None
                    _debug_cal_done = True
                    _enc_cal_auto_started = False
                    stop_all_motors()
                    auto_mode = False
                    auto_step = 0
                    _show_cal_delta(1, _cal_delta_M1)
                    pass
                    pass
                else:
                    _cvx, _cvy = rotate_velocity(cal_Vx, cal_Vy, face)
                    if INVERT_VX:
                        _cvx = -_cvx
                    if INVERT_VY:
                        _cvy = -_cvy
                    _cw = cal_omega
                    if INVERT_OMEGA:
                        _cw = -_cw
                    M1p, M2p, M3p = omni_kinematics(_cvx, _cvy, _cw)
                    __motor_M1.set_power(M1p)
                    __motor_M2.set_power(M2p)
                    __motor_M3.set_power(M3p)
            elif tag == 'enc_move':
                _, total_ticks, vy_power, vx_power = step
                if _enc_step_initialized != auto_step:
                    try:
                        _enc_move_start(total_ticks, vy_power, vx_power)
                    except Exception:
                        stop_all_motors()
                        auto_mode = False
                        auto_step = 0
                        _enc_step_initialized = -1
                        __led.show("ERR")
                        time.sleep(0.2)
                        continue
                    _enc_step_initialized = auto_step
                next_step = AUTO_SEQUENCE[auto_step + 1] if auto_step + 1 < len(AUTO_SEQUENCE) else None
                next_is_enc_move = (next_step is not None
                                    and isinstance(next_step[0], str)
                                    and next_step[0] == 'enc_move')
                if _enc_move_tick(max(abs(vy_power), abs(vx_power)), stop_motors=(not next_is_enc_move)):
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                        stop_all_motors()
                    else:
                        auto_step_start = novapi.timer()
            elif tag == 'enc_rot':
                _, total_ticks, _vy, omega_power = step
                if _enc_step_initialized != auto_step:
                    _enc_rot_start(total_ticks, omega_power)
                    _enc_step_initialized = auto_step
                next_step = AUTO_SEQUENCE[auto_step + 1] if auto_step + 1 < len(AUTO_SEQUENCE) else None
                next_is_enc_rot = (next_step is not None
                                   and isinstance(next_step[0], str)
                                   and next_step[0] == 'enc_rot')
                if _enc_rot_tick(abs(omega_power), stop_motors=(not next_is_enc_rot)):
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                        stop_all_motors()
                    else:
                        auto_step_start = novapi.timer()
            elif tag == 'enc_moverot':
                # 组合闭环：边平移边自旋（方案 C）。一步内既走 ticks 距离又转 rot_ticks
                #   step = ('enc_moverot', ticks, vy_power, vx_power, omega_power, rot_ticks)
                _, total_ticks, vy_power, vx_power, omega_power, rot_ticks = step
                if _enc_step_initialized != auto_step:
                    _enc_moverot_start(total_ticks, vy_power, vx_power,
                                       omega_power, rot_ticks)
                    _enc_step_initialized = auto_step

                next_step = AUTO_SEQUENCE[auto_step + 1] if auto_step + 1 < len(AUTO_SEQUENCE) else None
                next_is_moverot = (next_step is not None
                                   and isinstance(next_step[0], str)
                                   and next_step[0] == 'enc_moverot')

                if _enc_move_tick(max(abs(vy_power), abs(vx_power), abs(omega_power)),
                                  stop_motors=(not next_is_moverot)):
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False; auto_step = 0
                        stop_all_motors()
                    else:
                        auto_step_start = novapi.timer()

            elif tag == 'enc_stop':
                stop_all_motors()
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                    pass
                else:
                    auto_step_start = novapi.timer()
                    pass
            elif tag == 'spin':
                _, deg, _w = step
                rot_speed = 90.0 * abs(_w) / 50.0
                need_dur = abs(deg) / max(rot_speed, 1.0)
                w_sign = 1 if deg > 0 else -1
                w_out = w_sign * abs(_w)
                if INVERT_OMEGA:
                    w_out = -w_out
                M1p, M2p, M3p = omni_kinematics(0, 0, w_out)
                __motor_M1.set_power(M1p)
                __motor_M2.set_power(M2p)
                __motor_M3.set_power(M3p)
                if elapsed >= need_dur:
                    stop_all_motors()
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                    else:
                        auto_step_start = novapi.timer()
            elif tag == 'delay':
                _, delay_dur = step[0], step[1]
                if elapsed >= delay_dur:
                    auto_step += 1
                    auto_step_start = novapi.timer()
                    pass
            elif tag == 'motor_pos':
                # 位置闭环：编码电机跑到目标角度即停（PID）。
                # step = ('motor_pos', motor_id, target_deg, kp, ki, kd)
                # 即发即走：启动后立即前进下一步，PID 由每帧 motor_pos_tick_all() 驱动 -> 边走边做
                _, mp_id, mp_target, mp_kp, mp_ki, mp_kd = step
                motor_pos_start(str(mp_id), float(mp_target),
                                float(mp_kp), float(mp_ki), float(mp_kd))
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                else:
                    auto_step_start = novapi.timer()
            elif tag == 'motor':
                _, motor_id, power = step
                motor_map = {"M1": __motor_M1, "M2": __motor_M2, "M3": __motor_M3}
                m = motor_map.get(str(motor_id))
                if m is not None:
                    m.set_power(int(power))
                    pass
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                else:
                    auto_step_start = novapi.timer()
            elif tag == 'dc_motor':
                _, dc_port, power = step
                power_expand_board.set_power(str(dc_port), int(power))
                pass
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                else:
                    auto_step_start = novapi.timer()
            elif tag == 'servo':
                pass
                auto_step += 1
                auto_step_start = novapi.timer()
            else:
                pass
                auto_step += 1
                auto_step_start = novapi.timer()
            if auto_step >= len(AUTO_SEQUENCE):
                stop_all_motors()
                auto_mode = False
                auto_step = 0
                auto_prev_Vx = 0.0
                auto_prev_Vy = 0.0
                auto_prev_omega = 0.0
                pass
            if not (_debug_cal_done and novapi.timer() < _cal_display_until):
                __led.show("S%d" % BL_ACTION_SPEED)
            time.sleep(AUTO_STEP_DELAY)
            continue
        step_duration, step_Vx, step_Vy, step_omega = step
        if INVERT_VX:
            step_Vx = -step_Vx
        if INVERT_VY:
            step_Vy = -step_Vy
        if INVERT_OMEGA:
            step_omega = -step_omega
        if elapsed >= step_duration:
            Vx_end, Vy_end = rotate_velocity(step_Vx, step_Vy, face)
            auto_prev_Vx = Vx_end
            auto_prev_Vy = Vy_end
            auto_prev_omega = step_omega
            auto_step += 1
            if auto_step >= len(AUTO_SEQUENCE):
                stop_all_motors()
                auto_mode = False
                auto_step = 0
                auto_prev_Vx = 0.0
                auto_prev_Vy = 0.0
                auto_prev_omega = 0.0
                pass
            else:
                auto_step_start = novapi.timer()
                next_step = AUTO_SEQUENCE[auto_step]
                if isinstance(next_step[0], str):
                    pass
                else:
                    next_dur, next_Vx, next_Vy, next_omega = next_step
                    pass
        else:
            Vx_target, Vy_target = rotate_velocity(step_Vx, step_Vy, face)
            omega_target = step_omega
            if AUTO_RAMP_MS > 0 and elapsed * 1000.0 < AUTO_RAMP_MS:
                alpha = elapsed * 1000.0 / AUTO_RAMP_MS  # 0 → 1
                Vx_out = auto_prev_Vx + (Vx_target - auto_prev_Vx) * alpha
                Vy_out = auto_prev_Vy + (Vy_target - auto_prev_Vy) * alpha
                omega_out = auto_prev_omega + (omega_target - auto_prev_omega) * alpha
            else:
                Vx_out = Vx_target
                Vy_out = Vy_target
                omega_out = omega_target
            step_ms = step_duration * 1000.0
            elapsed_ms = elapsed * 1000.0
            if AUTO_ACCEL_MS > 0 and step_ms > AUTO_ACCEL_MS * 2:
                if elapsed_ms < AUTO_ACCEL_MS:
                    accel = elapsed_ms / AUTO_ACCEL_MS
                elif elapsed_ms > step_ms - AUTO_ACCEL_MS:
                    accel = (step_ms - elapsed_ms) / AUTO_ACCEL_MS
                else:
                    accel = 1.0
            else:
                accel = 1.0
            Vx_out *= accel
            Vy_out *= accel
            omega_out *= accel
            M1_power, M2_power, M3_power = omni_kinematics(Vx_out, Vy_out, omega_out)
            __motor_M1.set_power(M1_power)
            __motor_M2.set_power(M2_power)
            __motor_M3.set_power(M3_power)
        if not (_debug_cal_done and novapi.timer() < _cal_display_until):
            __led.show("S%d" % BL_ACTION_SPEED)
        time.sleep(AUTO_STEP_DELAY)
        continue  # 跳过手动/调试逻辑
    if debug_mode:
        cur_Up = gamepad.is_key_pressed("Up")
        cur_Down = gamepad.is_key_pressed("Down")
        cur_Left = gamepad.is_key_pressed("Left")
        cur_Right = gamepad.is_key_pressed("Right")
