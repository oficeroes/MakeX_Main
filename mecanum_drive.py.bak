# ==================== 编码器闭环参数（基于 novapi get_value("angle") 角度制）====================
# novapi 编码电机使用 get_value("angle") 返回角度（度），没有 get_count()！
# ENCODER_TICKS_PER_CM: GUI 端标定常数（编码器角度/cm），机器人端用于距离换算
ENCODER_TICKS_PER_CM = 18.0000
# Novapi move() 使用编码器角度。这里必须用实测角度/cm，
# 不能用理想轮周 360/(πD)，否则实际距离会明显偏小。
_DEG_PER_CM = ENCODER_TICKS_PER_CM
_TICKS_TO_DEG = 1.0
# 到位死区（度）：电机角度误差小于此值视为到达
PROFILE_DEADBAND_DEG = 8
# 每步最大等待时间（秒），防止卡死
_ENC_STEP_TIMEOUT = 8.0
# 功率 → rpm 映射：move(deg, rpm) 的速度参数
# power=85 → 680rpm（电机物理解限约200-250rpm，设高确保不成为瓶颈）
_RPM_PER_POWER = 8.0

# Keep all encoder moves on the same novapi move() position loop.  The old raw
# power strafe mode made sideways motion much faster than forward motion.
STRAFE_POWER_MODE = False
STRAFE_DOMINANT_RATIO = 0.55
STRAFE_POWER_BOOST = 1.35
STRAFE_MIN_POWER = 75
STRAFE_DISTANCE_SCALE = 1.00
STRAFE_DECEL_START = 0.92

# 编码器闭环状态（简化：用 novapi 内置 move() 替代自定义 PID）
_enc_targets = [0, 0, 0, 0]        # M1-M4 目标角度（绝对角度，度）
_enc_step_initialized = -1           # 已初始化的 auto_step 索引
_enc_step_start_time = 0.0           # 当前步开始时刻

# ==================== 编码器闭环函数（基于 novapi move() + get_value("angle")）====================
# novapi 编码电机有内置位置闭环 move(degrees, rpm)，无需自己写 PID！
# get_value("angle") 返回当前角度（度），move() 是非阻塞的相对角度转动。

_motors = None  # 延迟初始化，在第一次调用时赋值

def _get_motors():
    """返回四轮电机列表（延迟初始化，避免模块加载顺序问题）"""
    global _motors
    if _motors is None:
        _motors = [__motor_M1, __motor_M2, __motor_M3, __motor_M4]
    return _motors


def _reset_drive_encoder_reference(reason="auto"):
    """Reset drive encoder reference before auto/calibration starts.

    Novapi encoder_motor.move() is relative, and this program also snapshots
    current angles before each encoder move, so manual pushes before start are
    already safe.  This function adds an explicit best-effort zero step for the
    pit/field workflow: if the firmware exposes a zeroing method, use it; either
    way, refresh the software baseline immediately before running.
    """
    global _enc_targets, _enc_step_initialized, _enc_step_start_time
    global _enc_power_mode, _enc_start_angles, _enc_move_degrees, _enc_move_powers
    global _burst_until, _last_nonzero

    motors = _get_motors()

    for m in motors:
        try:
            m.set_power(0)
        except Exception:
            pass
    time.sleep(0.05)

    reset_count = 0
    for m in motors:
        did_reset = False
        for method_name in ("set_zero", "reset_angle", "reset_encoder"):
            try:
                getattr(m, method_name)()
                did_reset = True
                break
            except Exception:
                pass
        if did_reset:
            reset_count += 1

    time.sleep(0.05)

    starts = []
    for m in motors:
        try:
            starts.append(m.get_value("angle"))
        except Exception:
            starts.append(0)

    _enc_targets = [int(v) for v in starts]
    _enc_start_angles = list(starts)
    _enc_move_degrees = [0, 0, 0, 0]
    _enc_move_powers = [0, 0, 0, 0]
    _enc_power_mode = False
    _enc_step_initialized = -1
    _enc_step_start_time = novapi.timer()
    _burst_until = [0.0, 0.0, 0.0, 0.0]
    _last_nonzero = [False, False, False, False]

    print(">>> enc_reset(%s): zero_methods=%d baseline M1=%d M2=%d M3=%d M4=%d" %
          (reason, reset_count, int(starts[0]), int(starts[1]),
           int(starts[2]), int(starts[3])))


def _show_cal_delta(motor_idx, value):
    """Highest-priority calibration readout for N1-N4."""
    global _cal_display_until
    if value is None:
        __led.show("NONE")
        print(">>> CAL M%d delta not ready" % motor_idx)
    else:
        delta = int(value)
        __led.show("E%d" % delta)
        print(">>> CAL M%d delta = %d" % (motor_idx, delta))
    _cal_display_until = novapi.timer() + _CAL_DISPLAY_HOLD_S


def _resolve_zero_enc_move(step_index, vy_power, vx_power):
    if abs(vy_power) >= 1 or abs(vx_power) >= 1:
        return vy_power, vx_power

    prev_vec = None
    next_vec = None

    i = step_index - 1
    while i >= 0:
        s = AUTO_SEQUENCE[i]
        if isinstance(s[0], str) and s[0] == 'enc_move':
            if abs(s[2]) >= 1 or abs(s[3]) >= 1:
                prev_vec = (s[2], s[3])
                break
        i -= 1

    i = step_index + 1
    while i < len(AUTO_SEQUENCE):
        s = AUTO_SEQUENCE[i]
        if isinstance(s[0], str) and s[0] == 'enc_move':
            if abs(s[2]) >= 1 or abs(s[3]) >= 1:
                next_vec = (s[2], s[3])
                break
        i += 1

    if prev_vec is not None and next_vec is not None:
        dot = prev_vec[0] * next_vec[0] + prev_vec[1] * next_vec[1]
        if dot > 0:
            vy = int(round((prev_vec[0] + next_vec[0]) / 2.0))
            vx = int(round((prev_vec[1] + next_vec[1]) / 2.0))
            if abs(vy) >= 1 or abs(vx) >= 1:
                print(">>> enc_move: repaired zero vector with neighbor average")
                return vy, vx
        print(">>> enc_move: repaired zero vector with next move")
        return next_vec[0], next_vec[1]

    if next_vec is not None:
        print(">>> enc_move: repaired zero vector with next move")
        return next_vec[0], next_vec[1]

    if prev_vec is not None:
        print(">>> enc_move: repaired zero vector with previous move")
        return prev_vec[0], prev_vec[1]

    return vy_power, vx_power


def _enc_move_start(total_ticks, vy_power, vx_power=0):
    """初始化编码器直走：计算目标角度 → 调用 novapi move()

    total_ticks: GUI 导出的 ticks 值（ticks = cm × ENCODER_TICKS_PER_CM）
    vy_power:   前进功率百分比（Vy，正=前）
    vx_power:   平移功率百分比（Vx，正=右，负=左）
    """
    global _enc_targets, _enc_step_start_time
    global _enc_power_mode, _enc_start_angles, _enc_move_degrees, _enc_move_powers

    motors = _get_motors()

    if abs(vy_power) < 1 and abs(vx_power) < 1:
        _enc_power_mode = False
        starts = [m.get_value("angle") for m in motors]
        _enc_targets = [int(v) for v in starts]
        _enc_step_start_time = novapi.timer()
        print(">>> enc_move: skip zero-power move (ticks=%d)" % total_ticks)
        return

    # ticks → cm → 度
    distance_cm = abs(total_ticks) / ENCODER_TICKS_PER_CM
    total_degrees = distance_cm * _DEG_PER_CM  # 每个轮子转动的角度

    # 运动方向由 total_ticks 符号决定（正=前进，负=后退）
    direction = 1 if total_ticks >= 0 else -1
    max_axis_power = max(abs(vy_power), abs(vx_power))
    strafe_dominant = (STRAFE_POWER_MODE
                       and max_axis_power > 0
                       and abs(vx_power) / max_axis_power >= STRAFE_DOMINANT_RATIO)
    if strafe_dominant:
        total_degrees *= STRAFE_DISTANCE_SCALE

    # 用运动学计算各轮方向与功率分配
    vy_dir = vy_power * direction
    vx_dir = vx_power * direction  # Vx 方向也跟随前进/后退符号
    M1p, M2p, M3p, M4p = mecanum_kinematics(vx_dir, vy_dir, 0)
    wheel_powers = [M1p, M2p, M3p, M4p]
    max_wheel_power = max(abs(M1p), abs(M2p), abs(M3p), abs(M4p))
    if max_wheel_power < 1:
        _enc_power_mode = False
        starts = [m.get_value("angle") for m in motors]
        _enc_targets = [int(v) for v in starts]
        _enc_step_start_time = novapi.timer()
        return
    scales = [abs(p) / max_wheel_power for p in wheel_powers]
    signs = [1 if M1p >= 0 else -1, 1 if M2p >= 0 else -1,
             1 if M3p >= 0 else -1, 1 if M4p >= 0 else -1]
    wheel_degrees = [signs[i] * total_degrees * scales[i] for i in range(4)]

    # 记录起始位置 → 计算目标绝对角度
    starts = [m.get_value("angle") for m in motors]
    _enc_targets = [int(starts[i] + wheel_degrees[i]) for i in range(4)]

    # 速度：功率% → rpm（取 Vy 和 Vx 中较大的）
    max_pwr = max(abs(vy_power), abs(vx_power))
    motor_rpm = max(30, int(max_pwr * _RPM_PER_POWER))

    if strafe_dominant:
        _enc_power_mode = True
        _enc_start_angles = starts
        _enc_move_degrees = [int(v) for v in wheel_degrees]
        boosted = [p * STRAFE_POWER_BOOST for p in wheel_powers]
        boosted_max = max(abs(boosted[0]), abs(boosted[1]), abs(boosted[2]), abs(boosted[3]))
        if boosted_max > 100:
            boost_scale = 100.0 / boosted_max
            boosted = [p * boost_scale for p in boosted]
        for i in range(4):
            if abs(boosted[i]) > 0 and abs(boosted[i]) < STRAFE_MIN_POWER:
                if boosted[i] > 0:
                    boosted[i] = STRAFE_MIN_POWER
                else:
                    boosted[i] = -STRAFE_MIN_POWER
        _enc_move_powers = boosted
        for i in range(4):
            try:
                if abs(_enc_move_degrees[i]) < 1:
                    motors[i].set_power(0)
                else:
                    motors[i].set_power(_enc_move_powers[i])
            except Exception:
                pass
        _enc_step_start_time = novapi.timer()
        print(">>> enc_strafe: %.1fcm Vx=%d Vy=%d power=%d" %
              (distance_cm, vx_power, vy_power,
               int(max(abs(_enc_move_powers[0]), abs(_enc_move_powers[1]),
                       abs(_enc_move_powers[2]), abs(_enc_move_powers[3])))))
        return

    _enc_power_mode = False

    # 调用 novapi 内置位置闭环：非阻塞，电机会自动停到目标
    for i in range(4):
        try:
            move_degrees = int(wheel_degrees[i])
            if abs(move_degrees) < 1:
                motors[i].set_power(0)
            else:
                move_rpm = max(30, int(motor_rpm * scales[i]))
                motors[i].move(move_degrees, move_rpm)
        except Exception:
            pass

    _enc_step_start_time = novapi.timer()
    print(">>> enc_move: %.1fcm (%d°) Vx=%d Vy=%d @%drpm" %
          (distance_cm, int(total_degrees), vx_power, vy_power, motor_rpm))


def _enc_move_tick(max_power, stop_motors=True):
    """编码器直走单步检测 → 返回 True=已到达目标

    novapi 的 move() 会自动减速停在目标角度，这里只需检查是否到位。
    加入超时保护防止卡死。

    v5.1: stop_motors=False 时到达目标不刹停，用于连续 enc_move 衔接。
    """
    global _enc_power_mode
    motors = _get_motors()

    try:
        power_mode = _enc_power_mode
    except NameError:
        power_mode = False

    if power_mode:
        if novapi.timer() - _enc_step_start_time > _ENC_STEP_TIMEOUT:
            if stop_motors:
                for m in motors:
                    m.set_power(0)
            _enc_power_mode = False
            print(">>> enc_strafe: timeout")
            return True

        progress = 1.0
        active = False
        for i in range(4):
            target = abs(_enc_move_degrees[i])
            if target > PROFILE_DEADBAND_DEG:
                active = True
                try:
                    moved = abs(motors[i].get_value("angle") - _enc_start_angles[i])
                    p = moved / target
                    if p < progress:
                        progress = p
                except Exception:
                    pass

        if (not active) or progress >= 1.0:
            if stop_motors:
                for m in motors:
                    m.set_power(0)
            _enc_power_mode = False
            return True

        factor = 1.0
        if progress >= STRAFE_DECEL_START:
            remain = (1.0 - progress) / max(1.0 - STRAFE_DECEL_START, 0.01)
            factor = max(0.45, min(1.0, remain))

        for i in range(4):
            try:
                if abs(_enc_move_degrees[i]) < 1:
                    motors[i].set_power(0)
                else:
                    motors[i].set_power(_enc_move_powers[i] * factor)
            except Exception:
                pass

        return False

    # 超时保护
    if novapi.timer() - _enc_step_start_time > _ENC_STEP_TIMEOUT:
        if stop_motors:
            for m in motors:
                m.set_power(0)
        print(">>> enc_move: 超时，强制进入下一步")
        return True

    # 检查四轮是否到位
    all_done = True
    for i in range(4):
        try:
            cur = motors[i].get_value("angle")
            if abs(_enc_targets[i] - cur) > PROFILE_DEADBAND_DEG:
                all_done = False
                break
        except Exception:
            pass

    if all_done:
        if stop_motors:
            for m in motors:
                m.set_power(0)
        return True

    return False


def _enc_rot_start(total_ticks, omega_power):
    """初始化编码器自旋：计算目标角度 → 调用 novapi move()"""
    global _enc_targets, _enc_step_start_time

    motors = _get_motors()

    if abs(omega_power) < 1:
        starts = [m.get_value("angle") for m in motors]
        _enc_targets = [int(v) for v in starts]
        _enc_step_start_time = novapi.timer()
        print(">>> enc_rot: skip zero-power rotate (ticks=%d)" % total_ticks)
        return

    # ticks → 旋转角度（度）
    # 自旋时 ticks 代表旋转编码量，直接换算为角度
    distance_cm = abs(total_ticks) / ENCODER_TICKS_PER_CM
    total_degrees = distance_cm * _DEG_PER_CM

    direction = 1 if total_ticks >= 0 else -1

    # 自旋运动学
    w_dir = omega_power * direction
    M1p, M2p, M3p, M4p = mecanum_kinematics(0, 0, w_dir)
    signs = [1 if M1p >= 0 else -1, 1 if M2p >= 0 else -1,
             1 if M3p >= 0 else -1, 1 if M4p >= 0 else -1]

    starts = [m.get_value("angle") for m in motors]
    _enc_targets = [int(starts[i] + signs[i] * total_degrees) for i in range(4)]

    motor_rpm = max(30, int(abs(omega_power) * _RPM_PER_POWER))

    for i in range(4):
        try:
            motors[i].move(int(signs[i] * total_degrees), motor_rpm)
        except Exception:
            pass

    _enc_step_start_time = novapi.timer()
    print(">>> enc_rot: %.1f° @%drpm" % (total_degrees, motor_rpm))


def _enc_rot_tick(max_power, stop_motors=True):
    """编码器自旋单步检测 → 返回 True=已到达目标（v5.1: 支持连续衔接）"""
    return _enc_move_tick(max_power, stop_motors=stop_motors)


# ==================== Startup ====================

__led.show("Main")
novapi.reset_timer()

# ==================== Main Loop ====================
while True:
    # ================================================================
    #  Auto Mode
    # ================================================================
    if auto_mode:
        elapsed = novapi.timer() - auto_step_start
        step = AUTO_SEQUENCE[auto_step]

        # ---- Tagged command tuple (first element is a string) ----
        if isinstance(step[0], str):
            tag = step[0]

            if tag == "servo":
                _, sv_id, angle, speed, wait_ms = step
                if elapsed < AUTO_STEP_DELAY * 1.5:
                    if _HAS_SERVO:
                        try:
                            sv = __servo_1 if sv_id in ("S1", "SV1") else __servo_2
                            sv.move_to(angle, speed)
                        except Exception:
                            pass
                if elapsed * 1000.0 >= wait_ms:
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                    else:
                        auto_step_start = novapi.timer()

            elif tag == "delay":
                dur = step[1]
                if elapsed >= dur:
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                    else:
                        auto_step_start = novapi.timer()

            elif tag == "motor":
                # 设置编码电机持续转动（立即执行，不等待）
                _, motor_id, power = step
                motor_map = {"M1": __motor_M1, "M2": __motor_M2, "M3": __motor_M3,
                             "M4": __motor_M4, "M5": __motor_M5}
                m = motor_map.get(str(motor_id))
                if m is not None:
                    m.set_power(int(power))
                    print(">>> motor %s → %d%%" % (motor_id, power))
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                else:
                    auto_step_start = novapi.timer()

            elif tag == "dc_motor":
                # 设置直流电机持续转动（立即执行，不等待）
                _, dc_port, power = step
                port = str(dc_port)
                power_expand_board.set_power(port, int(power))
                print(">>> dc_motor %s → %d%%" % (port, power))
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                else:
                    auto_step_start = novapi.timer()

            elif tag == "enc_move":
                # v5.1 编码器闭环：使用 novapi 内置 move()，支持 Vx+Vy 双分量
                # 修复"一格一格走"：当下一步也是 enc_move 时，不刹停，直接衔接
                _, total_ticks, vy_power, vx_power = step
                vy_power, vx_power = _resolve_zero_enc_move(auto_step, vy_power, vx_power)
                if _enc_step_initialized != auto_step:
                    _enc_move_start(total_ticks, vy_power, vx_power)
                    _enc_step_initialized = auto_step

                # 预判下一步：如果是连续同向 enc_move，提前衔接避免停顿
                next_step = AUTO_SEQUENCE[auto_step + 1] if auto_step + 1 < len(AUTO_SEQUENCE) else None
                next_is_enc_move = (next_step is not None
                                    and isinstance(next_step[0], str)
                                    and next_step[0] == 'enc_move')

                max_pwr = max(abs(vy_power), abs(vx_power))
                if _enc_move_tick(max_pwr, stop_motors=(not next_is_enc_move)):
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False; auto_step = 0
                        stop_all_motors()
                    else:
                        auto_step_start = novapi.timer()

            elif tag == "enc_rot":
                # v5.1 编码器闭环自旋：使用 novapi 内置 move() 位置控制
                # 修复"一格一格走"：当下一步也是 enc_rot 时，不刹停，直接衔接
                _, total_ticks, _vy, omega_power = step
                if _enc_step_initialized != auto_step:
                    _enc_rot_start(total_ticks, omega_power)
                    _enc_step_initialized = auto_step

                next_step = AUTO_SEQUENCE[auto_step + 1] if auto_step + 1 < len(AUTO_SEQUENCE) else None
                next_is_enc_rot = (next_step is not None
                                   and isinstance(next_step[0], str)
                                   and next_step[0] == 'enc_rot')

                if _enc_rot_tick(abs(omega_power), stop_motors=(not next_is_enc_rot)):
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False; auto_step = 0
                        stop_all_motors()
                    else:
                        auto_step_start = novapi.timer()

            elif tag == "enc_stop":
                # v5 停止缓冲：短暂停顿后进入下一步（不终止整个序列）
                stop_all_motors()
                auto_step += 1
                if auto_step >= len(AUTO_SEQUENCE):
                    auto_mode = False
                    auto_step = 0
                    print(">>> 编码器序列完成")
                else:
                    auto_step_start = novapi.timer()
                    print(">>> enc_stop → 步骤 %d/%d" % (auto_step + 1, len(AUTO_SEQUENCE)))

            elif tag == "encoder_cal":
                # Encoder calibration from GUI: record angles → drive → compute deltas
                _, cal_dur, cal_Vx, cal_Vy, cal_omega = step  # 5-tuple
                if not _enc_cal_auto_started:
                    _reset_drive_encoder_reference("encoder_cal")
                    # First tick: snapshot start encoder angles
                    _enc_cal_M1_start = __motor_M1.get_value("angle")
                    _enc_cal_M2_start = __motor_M2.get_value("angle")
                    _enc_cal_M3_start = __motor_M3.get_value("angle")
                    _enc_cal_M4_start = __motor_M4.get_value("angle")
                    auto_step_start = novapi.timer()
                    _enc_cal_auto_started = True
                    __led.show("CAL")
                    print(">>> 编码器标定开始（GUI）！初始角度 M1=%d M2=%d M3=%d M4=%d" %
                          (_enc_cal_M1_start, _enc_cal_M2_start,
                           _enc_cal_M3_start, _enc_cal_M4_start))

                if elapsed >= cal_dur:
                    # Calibration complete: record end angles
                    M1_end = __motor_M1.get_value("angle")
                    M2_end = __motor_M2.get_value("angle")
                    M3_end = __motor_M3.get_value("angle")
                    M4_end = __motor_M4.get_value("angle")
                    _cal_delta_M1 = M1_end - _enc_cal_M1_start
                    _cal_delta_M2 = M2_end - _enc_cal_M2_start
                    _cal_delta_M3 = M3_end - _enc_cal_M3_start
                    _cal_delta_M4 = M4_end - _enc_cal_M4_start
                    _debug_cal_done = True
                    _enc_cal_auto_started = False
                    _cal_display_until = novapi.timer() + _CAL_DISPLAY_HOLD_S
                    stop_all_motors()
                    auto_mode = False
                    auto_step = 0
                    __led.show("done")
                    print(">>> 编码器标定完成！增量: M1=%d M2=%d M3=%d M4=%d" %
                          (_cal_delta_M1, _cal_delta_M2, _cal_delta_M3, _cal_delta_M4))
                    print("    按 N1/N2/N3/N4 在 LED 查看各电机增量（E####）")
                else:
                    # Drive forward during calibration
                    _cvx = cal_Vx
                    _cvy = cal_Vy
                    _cw = cal_omega
                    if INVERT_VX:
                        _cvx = -_cvx
                    if INVERT_VY:
                        _cvy = -_cvy
                    if INVERT_OMEGA:
                        _cw = -_cw
                    M1p, M2p, M3p, M4p = mecanum_kinematics(_cvx, _cvy, _cw)
                    __motor_M1.set_power(M1p)
                    __motor_M2.set_power(M2p)
                    __motor_M3.set_power(M3p)
                    __motor_M4.set_power(M4p)

            elif tag == "spin":
                # Spin in place: ("spin", degrees, omega_power)
                _, deg, _w = step
                rot_speed = 90.0 * abs(_w) / 50.0
                need_dur = abs(deg) / max(rot_speed, 1.0)
                if elapsed < AUTO_STEP_DELAY * 1.5:
                    pass
                w_sign = 1 if deg > 0 else -1
                w_out = w_sign * abs(_w)
                _sp = mecanum_kinematics(0, 0, w_out)
                __motor_M1.set_power(_sp[0])
                __motor_M2.set_power(_sp[1])
                __motor_M3.set_power(_sp[2])
                __motor_M4.set_power(_sp[3])
                if elapsed >= need_dur:
                    __motor_M1.set_power(0)
                    __motor_M2.set_power(0)
                    __motor_M3.set_power(0)
                    __motor_M4.set_power(0)
                    auto_step += 1
                    if auto_step >= len(AUTO_SEQUENCE):
                        auto_mode = False
                        auto_step = 0
                    else:
                        auto_step_start = novapi.timer()

            else:
                # Unknown tag: skip
                auto_step += 1
                auto_step_start = novapi.timer()

            time.sleep(AUTO_STEP_DELAY)
            continue

        # ---- Standard 4-tuple motion step ----
        step_duration, step_Vx, step_Vy, step_omega = step

        if INVERT_VX:
            step_Vx = -step_Vx
        if INVERT_VY:
            step_Vy = -step_Vy
        if INVERT_OMEGA:
            step_omega = -step_omega

        if elapsed >= step_duration:
            auto_prev_Vx = step_Vx
            auto_prev_Vy = step_Vy
            auto_prev_omega = step_omega
            auto_step += 1
            if auto_step >= len(AUTO_SEQUENCE):
                stop_all_motors()
                auto_mode = False
                auto_step = 0
                auto_prev_Vx = 0.0
                auto_prev_Vy = 0.0
                auto_prev_omega = 0.0
            else:
                auto_step_start = novapi.timer()
                nstep = AUTO_SEQUENCE[auto_step]
                if not isinstance(nstep[0], str):
                    nd, nVx, nVy, nw = nstep
        else:
            # Between-step interpolation
            if AUTO_RAMP_MS > 0 and elapsed * 1000.0 < AUTO_RAMP_MS:
                alpha = elapsed * 1000.0 / AUTO_RAMP_MS
                Vx_out = auto_prev_Vx + (step_Vx - auto_prev_Vx) * alpha
                Vy_out = auto_prev_Vy + (step_Vy - auto_prev_Vy) * alpha
                omega_out = auto_prev_omega + (step_omega - auto_prev_omega) * alpha
            else:
                Vx_out = step_Vx
                Vy_out = step_Vy
                omega_out = step_omega

            # Within-step acceleration ramp (0→100→0) to prevent wheel slip
            step_ms = step_duration * 1000.0
            elapsed_ms = elapsed * 1000.0
            if AUTO_ACCEL_MS > 0 and step_ms > AUTO_ACCEL_MS * 2:
                if elapsed_ms < AUTO_ACCEL_MS:
                    # Ramp up: power goes 0 → target
                    accel = elapsed_ms / AUTO_ACCEL_MS
                elif elapsed_ms > step_ms - AUTO_ACCEL_MS:
                    # Ramp down: power goes target → 0
                    accel = (step_ms - elapsed_ms) / AUTO_ACCEL_MS
                else:
                    # Cruise at full power
                    accel = 1.0
            else:
                accel = 1.0

            Vx_out *= accel
            Vy_out *= accel
            omega_out *= accel

            M1p, M2p, M3p, M4p = mecanum_kinematics(Vx_out, Vy_out, omega_out)
            __motor_M1.set_power(M1p)
            __motor_M2.set_power(M2p)
            __motor_M3.set_power(M3p)
            __motor_M4.set_power(M4p)

        time.sleep(AUTO_STEP_DELAY)
        continue

    # ================================================================
    #  Debug Mode
    # ================================================================
    if debug_mode:
        cur_Up = gamepad.is_key_pressed("Up")
        cur_Down = gamepad.is_key_pressed("Down")
        cur_Left = gamepad.is_key_pressed("Left")
        cur_Right = gamepad.is_key_pressed("Right")
        cur_N1 = gamepad.is_key_pressed("N1")
        cur_N2 = gamepad.is_key_pressed("N2")
        cur_N3 = gamepad.is_key_pressed("N3")
        cur_N4 = gamepad.is_key_pressed("N4")
        cur_Plus = gamepad.is_key_pressed("+")
        cur_Menu = gamepad.is_key_pressed("≡")
        cur_R1 = gamepad.is_key_pressed("R1")
        cur_L1 = gamepad.is_key_pressed("L1")

        # ≡ key: exit debug mode
        if cur_Menu and not last_Menu:
            debug_stop_motor()
            debug_mode = False
            stop_all_motors()
            __led.show("Main")
            last_Up = last_Down = last_Left = last_Right = False
            last_N1 = last_N2 = last_N3 = last_N4 = False
            last_Menu = cur_Menu
            debug_show_ok = False
            time.sleep(0.3)
            continue

        # ----------------------------------------------------------------
        #  + key: encoder calibration / auto sequence
        #    If AUTO_SEQUENCE has a tagged step → start auto sequence
        #    Otherwise → built-in blocking calibration
        # ----------------------------------------------------------------
        if cur_Plus and not last_Plus:
            last_Plus = cur_Plus

            # Check if GUI exported a calibration / auto sequence
            if len(AUTO_SEQUENCE) > 0 and isinstance(AUTO_SEQUENCE[0][0], str):
                # Start auto sequence (exits debug mode)
                debug_stop_motor()
                debug_mode = False
                stop_all_motors()
                _reset_drive_encoder_reference("debug_auto")
                _debug_cal_done = False
                _enc_cal_auto_started = False
                _enc_step_initialized = -1
                _cal_delta_M1 = _cal_delta_M2 = _cal_delta_M3 = _cal_delta_M4 = None
                auto_mode = True
                auto_step = 0
                auto_step_start = novapi.timer()
                auto_prev_Vx = 0.0
                auto_prev_Vy = 0.0
                auto_prev_omega = 0.0
                tag0 = AUTO_SEQUENCE[0][0]
                print(">>> 自动程序启动（从调试模式）！步骤 1/%d: %s" %
                      (len(AUTO_SEQUENCE), tag0))
                __led.show("auto")
                last_Up = last_Down = last_Left = last_Right = False
                last_N1 = last_N2 = last_N3 = last_N4 = False
                last_Menu = cur_Menu
                time.sleep(0.3)
                continue

            # --- Built-in calibration (blocking inner loop) ---
            stop_all_motors()
            _reset_drive_encoder_reference("debug_cal")
            _enc_cal_start[:] = [
                __motor_M1.get_value("angle"),
                __motor_M2.get_value("angle"),
                __motor_M3.get_value("angle"),
                __motor_M4.get_value("angle"),
            ]
            __led.show("Cal")
            novapi.reset_timer()
            # --- drive loop ---
            while True:
                cal_elapsed = novapi.timer()
                cal_dur_ms = DEBUG_CAL_DURATION * 1000.0
                cal_elapsed_ms = cal_elapsed * 1000.0
                # 0 → full → 0 ramp
                if DEBUG_CAL_ACCEL_MS > 0 and cal_dur_ms > DEBUG_CAL_ACCEL_MS * 2:
                    if cal_elapsed_ms < DEBUG_CAL_ACCEL_MS:
                        accel = cal_elapsed_ms / DEBUG_CAL_ACCEL_MS
                    elif cal_elapsed_ms > cal_dur_ms - DEBUG_CAL_ACCEL_MS:
                        accel = (cal_dur_ms - cal_elapsed_ms) / DEBUG_CAL_ACCEL_MS
                    else:
                        accel = 1.0
                else:
                    accel = 1.0
                cal_vy = DEBUG_CAL_POWER
                if INVERT_VY:
                    cal_vy = -cal_vy
                cal_vy = cal_vy * accel
                M1p, M2p, M3p, M4p = mecanum_kinematics(0, cal_vy, 0)
                __motor_M1.set_power(M1p)
                __motor_M2.set_power(M2p)
                __motor_M3.set_power(M3p)
                __motor_M4.set_power(M4p)
                time.sleep(LOOP_DELAY)
                if cal_elapsed >= DEBUG_CAL_DURATION:
                    break
            # --- stop and record ---
            __motor_M1.set_power(0)
            __motor_M2.set_power(0)
            __motor_M3.set_power(0)
            __motor_M4.set_power(0)
            _enc_end = [
                __motor_M1.get_value("angle"),
                __motor_M2.get_value("angle"),
                __motor_M3.get_value("angle"),
                __motor_M4.get_value("angle"),
            ]
            _cal_delta_M1 = _enc_end[0] - _enc_cal_start[0]
            _cal_delta_M2 = _enc_end[1] - _enc_cal_start[1]
            _cal_delta_M3 = _enc_end[2] - _enc_cal_start[2]
            _cal_delta_M4 = _enc_end[3] - _enc_cal_start[3]
            _debug_cal_done = True
            # Show M1 delta right away; N1-N4 can recall each motor below
            _show_cal_delta(1, _cal_delta_M1)
            time.sleep(0.5)
            continue

        last_Plus = cur_Plus

        # ----------------------------------------------------------------
        #  After calibration: N1/N2/N3/N4 show each motor's delta
        # ----------------------------------------------------------------
        cal_key_handled = False
        if _debug_cal_done:
            if cur_N1 and not last_N1:
                _show_cal_delta(1, _cal_delta_M1)
                cal_key_handled = True
            if cur_N2 and not last_N2:
                _show_cal_delta(2, _cal_delta_M2)
                cal_key_handled = True
            if cur_N3 and not last_N3:
                _show_cal_delta(3, _cal_delta_M3)
                cal_key_handled = True
            if cur_N4 and not last_N4:
                _show_cal_delta(4, _cal_delta_M4)
                cal_key_handled = True

        if cal_key_handled:
            last_Up = cur_Up
            last_Down = cur_Down
            last_Left = cur_Left
            last_Right = cur_Right
            last_N1 = cur_N1
            last_N2 = cur_N2
            last_N3 = cur_N3
            last_N4 = cur_N4
            last_Menu = cur_Menu
            time.sleep(LOOP_DELAY)
            continue

        # D-pad ↑/↓: switch motor type
        if cur_Up and not last_Up:
            debug_motor_type = (debug_motor_type + 1) % len(DEBUG_MOTOR_TYPES)
            max_idx = len(DEBUG_ALL_NAMES[debug_motor_type]) - 1
            if debug_motor_index > max_idx:
                debug_motor_index = 0
            name = DEBUG_ALL_NAMES[debug_motor_type][debug_motor_index]
            __led.show(name)
        if cur_Down and not last_Down:
            debug_motor_type = (debug_motor_type - 1) % len(DEBUG_MOTOR_TYPES)
            max_idx = len(DEBUG_ALL_NAMES[debug_motor_type]) - 1
            if debug_motor_index > max_idx:
                debug_motor_index = 0
            name = DEBUG_ALL_NAMES[debug_motor_type][debug_motor_index]
            __led.show(name)

        # D-pad ←/→: switch motor index
        max_idx = len(DEBUG_ALL_NAMES[debug_motor_type]) - 1
        if cur_Left and not last_Left:
            debug_motor_index = (debug_motor_index - 1) % (max_idx + 1)
            name = DEBUG_ALL_NAMES[debug_motor_type][debug_motor_index]
            __led.show(name)
        if cur_Right and not last_Right:
            debug_motor_index = (debug_motor_index + 1) % (max_idx + 1)
            name = DEBUG_ALL_NAMES[debug_motor_type][debug_motor_index]
            __led.show(name)

        # Idle display
        if not cur_N1 and not cur_N4:
            if debug_show_ok:
                if novapi.timer() >= debug_show_speed_until:
                    debug_show_ok = False
            elif debug_show_speed_until > 0 and novapi.timer() < debug_show_speed_until:
                if debug_motor_type == 3:
                    __led.show("A%d" % DEBUG_SERVO_ANGLE)
                else:
                    __led.show("S%d" % DEBUG_TEST_SPEED)
            elif _debug_cal_done and novapi.timer() < _cal_display_until:
                pass
            else:
                __led.show(DEBUG_ALL_NAMES[debug_motor_type][debug_motor_index])

        # N1/N4: motor test
        servo_moved = False
        if debug_motor_type == 3:
            servo_moved = True
            if _HAS_SERVO:
                try:
                    _sv = [__servo_1, __servo_2][debug_motor_index]
                except Exception:
                    _sv = None
                if cur_N1 and not last_N1 and _sv:
                    _sv.move_to(servo_dir * DEBUG_SERVO_ANGLE, SERVO_MOVE_SPEED)
                elif cur_N4 and not last_N4 and _sv:
                    _sv.move_to(0, SERVO_MOVE_SPEED)
            speed = 0
        else:
            if cur_N1:
                speed = DEBUG_TEST_SPEED
            elif cur_N4:
                if debug_motor_type == 2:
                    speed = 0
                else:
                    speed = -DEBUG_TEST_SPEED
            else:
                speed = 0

        # N2/N3: adjust speed/angle
        if cur_N2 and not last_N2:
            if debug_motor_type == 3:
                DEBUG_SERVO_ANGLE = min(360, DEBUG_SERVO_ANGLE + 5)
                debug_show_speed_until = novapi.timer() + 2.0
            else:
                DEBUG_TEST_SPEED = min(100, DEBUG_TEST_SPEED + 10)
                debug_show_speed_until = novapi.timer() + 2.0
        if cur_N3 and not last_N3:
            if debug_motor_type == 3:
                DEBUG_SERVO_ANGLE = max(0, DEBUG_SERVO_ANGLE - 5)
                debug_show_speed_until = novapi.timer() + 2.0
            else:
                DEBUG_TEST_SPEED = max(0, DEBUG_TEST_SPEED - 10)
                debug_show_speed_until = novapi.timer() + 2.0

        # R1: set servo zero
        if debug_motor_type == 3 and cur_R1 and not last_R1 and _HAS_SERVO:
            try:
                _sv = [__servo_1, __servo_2][debug_motor_index]
                _sv.set_zero()
                __led.show("OK")
                debug_show_speed_until = novapi.timer() + 1.0
                debug_show_ok = True
                servo_moved = True
            except Exception:
                pass

        # L1: toggle servo direction
        if debug_motor_type == 3 and cur_L1 and not last_L1:
            servo_dir = -servo_dir

        # Output
        if debug_motor_type == 0:
            motor = [__motor_M1, __motor_M2, __motor_M3, __motor_M4, __motor_M5][debug_motor_index]
            motor.set_power(speed)
        elif debug_motor_type == 1:
            port = [DC_COLLECTOR_PORT1, DC_COLLECTOR_PORT2][debug_motor_index]
            power_expand_board.set_power(port, speed)
        elif debug_motor_type == 2:
            port = ["BL1", "BL2"][debug_motor_index]
            power_expand_board.set_power(port, speed)
        # type 3 (servo) handled above via move_to, skip set_power

        last_Up = cur_Up
        last_Down = cur_Down
        last_Left = cur_Left
        last_Right = cur_Right
        last_N1 = cur_N1
        last_N2 = cur_N2
        last_N3 = cur_N3
        last_N4 = cur_N4
        last_Menu = cur_Menu

        time.sleep(LOOP_DELAY)
        continue

    # ================================================================
    #  Normal Mode (Remote Control)
    # ================================================================
    # --- 1. Read joysticks ---
    Lx = gamepad.get_joystick("Lx")
    Ly = gamepad.get_joystick("Ly")
    Rx = gamepad.get_joystick("Rx")

    # --- 2. Read buttons ---
    cur_N1 = gamepad.is_key_pressed("N1")
    cur_N2 = gamepad.is_key_pressed("N2")
    cur_N3 = gamepad.is_key_pressed("N3")
    cur_N4 = gamepad.is_key_pressed("N4")
    cur_Plus = gamepad.is_key_pressed("+")
    cur_Menu = gamepad.is_key_pressed("≡")
    cur_L1 = gamepad.is_key_pressed("L1")
    cur_R1 = gamepad.is_key_pressed("R1")
    cur_L2 = gamepad.is_key_pressed("L2")
    cur_R2 = gamepad.is_key_pressed("R2")
    cur_Dpad_Up = gamepad.is_key_pressed("Up")
    cur_Dpad_Down = gamepad.is_key_pressed("Down")
    cur_Dpad_Left = gamepad.is_key_pressed("Left")
    cur_Dpad_Right = gamepad.is_key_pressed("Right")

    # D-pad 冲突保护：连续 3 次同时按下才拦截（避免单次信号抖动误杀）
    if cur_Dpad_Left and cur_Dpad_Right:
        _dpad_lr_conflict += 1
    else:
        _dpad_lr_conflict = 0
    if _dpad_lr_conflict >= 3:
        cur_Dpad_Left = False
        cur_Dpad_Right = False

    if cur_Dpad_Up and cur_Dpad_Down:
        _dpad_ud_conflict += 1
    else:
        _dpad_ud_conflict = 0
    if _dpad_ud_conflict >= 3:
        cur_Dpad_Up = False
        cur_Dpad_Down = False

    # --- 3. Menu key: toggle debug mode ---
    if cur_Menu and not last_Menu:
        if debug_mode:
            debug_stop_motor()
            debug_mode = False
            stop_all_motors()
            __led.show("Main")
        else:
            debug_mode = True
            debug_motor_type = 0
            debug_motor_index = 0
            __led.show("Test")
            __led.show("M1")
        last_Menu = cur_Menu
        # Reset all edge vars to prevent false triggers
        last_Up = last_Down = last_Left = last_Right = False
        last_N1 = last_N2 = last_N3 = last_N4 = False
        last_R2 = last_L1 = last_R1 = last_L2 = last_Plus = False
        last_Dpad_Up = last_Dpad_Down = last_Dpad_Left = last_Dpad_Right = False
        _dpad_lr_conflict = _dpad_ud_conflict = 0
        time.sleep(0.3)
        continue

    # --- 3b. Highest priority: encoder calibration readout ---
    # After a GUI/built-in encoder calibration, N1-N4 must show M1-M4 deltas
    # instead of triggering the normal servo/collector/roller functions.
    cal_key_handled = False
    if _debug_cal_done:
        if cur_N1 and not last_N1:
            _show_cal_delta(1, _cal_delta_M1)
            cal_key_handled = True
        if cur_N2 and not last_N2:
            _show_cal_delta(2, _cal_delta_M2)
            cal_key_handled = True
        if cur_N3 and not last_N3:
            _show_cal_delta(3, _cal_delta_M3)
            cal_key_handled = True
        if cur_N4 and not last_N4:
            _show_cal_delta(4, _cal_delta_M4)
            cal_key_handled = True

    if cal_key_handled:
        last_N1 = cur_N1
        last_N2 = cur_N2
        last_N3 = cur_N3
        last_N4 = cur_N4
        last_Menu = cur_Menu
        last_L1 = cur_L1
        last_R1 = cur_R1
        last_L2 = cur_L2
        last_R2 = cur_R2
        last_Dpad_Up = cur_Dpad_Up
        last_Dpad_Down = cur_Dpad_Down
        last_Dpad_Left = cur_Dpad_Left
        last_Dpad_Right = cur_Dpad_Right
        last_Plus = cur_Plus
        time.sleep(LOOP_DELAY)
        continue

    # --- 4. D-pad ←: DC3 振荡 -100↔+100（按一下启动，再按停） ---
    if cur_Dpad_Left and not last_Dpad_Left:
        dc3_osc = not dc3_osc
        if dc3_osc:
            dc3_osc_dir = 1
            dc3_osc_timer = novapi.timer()
            print(">>> D-pad←: DC3 振荡启动")
        else:
            power_expand_board.set_power(DC_COLLECTOR_PORT3, 0)
            print(">>> D-pad←: DC3 停止")
    if dc3_osc and novapi.timer() - dc3_osc_timer >= 0.5:
        dc3_osc_dir = -dc3_osc_dir
        dc3_osc_timer = novapi.timer()
        power_expand_board.set_power(DC_COLLECTOR_PORT3, dc3_osc_dir * 100)

    # D-pad ↑/↓: 无刷电机速度 ±5（范围 10~100）
    if cur_Dpad_Up and not last_Dpad_Up:
        BL_ACTION_SPEED = min(100, BL_ACTION_SPEED + 5)
        if bl1_on:
            power_expand_board.set_power("BL1", BL_ACTION_SPEED)
            power_expand_board.set_power("BL2", BL_ACTION_SPEED)
        print(">>> D-pad↑: 无刷速度 = %d" % BL_ACTION_SPEED)
    if cur_Dpad_Down and not last_Dpad_Down:
        BL_ACTION_SPEED = max(10, BL_ACTION_SPEED - 5)
        if bl1_on:
            power_expand_board.set_power("BL1", BL_ACTION_SPEED)
            power_expand_board.set_power("BL2", BL_ACTION_SPEED)
        print(">>> D-pad↓: 无刷速度 = %d" % BL_ACTION_SPEED)
    # D-pad → 空

    # --- 5. L1: 面翻转（正面↔反面）---
    if cur_L1 and not last_L1:
        face_flipped = not face_flipped
        if face_flipped:
            print(">>> L1: 面翻转 → 反面")
        else:
            print(">>> L1: 面翻转 → 正面")

    # --- 6. R2: 双无刷 BL1+BL2 同时开关 ---
    if cur_R2 and not last_R2:
        bl1_on = not bl1_on
        bl2_on = not bl2_on
        if bl1_on:
            power_expand_board.set_power("BL1", BL_ACTION_SPEED)
            power_expand_board.set_power("BL2", BL_ACTION_SPEED)
            print(">>> R2: 双无刷启动 @%d" % BL_ACTION_SPEED)
        else:
            power_expand_board.stop("BL1")
            power_expand_board.stop("BL2")
            print(">>> R2: 双无刷停止")
    # R1 / L2 无效果

    # --- 7. N-keys ---
    # N1: 双舵机（仅在无刷已启动时有效）
    if cur_N1 and not last_N1:
        if not bl1_on and not bl2_on:
            print(">>> N1: 无刷未启动，舵机锁定")
            __led.show("LOCK")
        elif _HAS_SERVO:
            try:
                __servo_1.move_to(SERVO1_ACTION_ANGLE, SERVO_ACTION_SPEED)
                __servo_2.move_to(SERVO2_ACTION_ANGLE, SERVO_ACTION_SPEED)
            except Exception:
                pass
            sv1_phase = 1; sv1_time = novapi.timer()
            sv2_phase = 1; sv2_time = novapi.timer()
            print(">>> N1: 双舵机触发")

    # N2: M5=-100 + DC2=+100  切换（按一下开，再按关，与N4互斥）
    if cur_N2 and not last_N2:
        n2_on = not n2_on
        if n2_on:
            n4_on = False
            __motor_M5.set_power(-100)
            power_expand_board.set_power(DC_COLLECTOR_PORT2, -100)
            print(">>> N2: M5=-100  DC2=-100  开")
        else:
            __motor_M5.set_power(0)
            power_expand_board.set_power(DC_COLLECTOR_PORT2, 0)
            print(">>> N2: 关")

    # N4: M5=+100 + DC2=-100  切换（按一下开，再按关，与N2互斥）
    if cur_N4 and not last_N4:
        n4_on = not n4_on
        if n4_on:
            n2_on = False
            __motor_M5.set_power(100)
            power_expand_board.set_power(DC_COLLECTOR_PORT2, 100)
            print(">>> N4: M5=+100  DC2=+100  开")
        else:
            __motor_M5.set_power(0)
            power_expand_board.set_power(DC_COLLECTOR_PORT2, 0)
            print(">>> N4: 关")

    # N3: unused

    # --- 8. Servo auto-close (SV1 + SV2, 由 N1 触发) ---

    # Update normal-mode edge variables
    last_N1 = cur_N1
    last_N2 = cur_N2
    last_N3 = cur_N3
    last_N4 = cur_N4
    last_Menu = cur_Menu
    last_L1 = cur_L1
    last_R1 = cur_R1
    last_L2 = cur_L2
    last_R2 = cur_R2
    last_Dpad_Up = cur_Dpad_Up
    last_Dpad_Down = cur_Dpad_Down
    last_Dpad_Left = cur_Dpad_Left
    last_Dpad_Right = cur_Dpad_Right

    # --- 10. Servo auto-close (SV1) ---
    if sv1_phase == 1 and novapi.timer() - sv1_time >= SERVO_RETURN_DELAY:
        if _HAS_SERVO:
            try:
                __servo_1.move_to(0, SERVO_ACTION_SPEED)
            except Exception:
                pass
        sv1_phase = 0

    # --- 11. Servo auto-close (SV2) ---
    if sv2_phase == 1 and novapi.timer() - sv2_time >= SERVO_RETURN_DELAY:
        if _HAS_SERVO:
            try:
                __servo_2.move_to(0, SERVO_ACTION_SPEED)
            except Exception:
                pass
        sv2_phase = 0

    # --- 12. + key: start auto program ---
    if cur_Plus and not last_Plus:
        stop_all_motors()
        _reset_drive_encoder_reference("auto")
        auto_mode = True
        auto_step = 0
        auto_step_start = novapi.timer()
        auto_prev_Vx = 0.0
        auto_prev_Vy = 0.0
        auto_prev_omega = 0.0
        # Clear old calibration data
        _debug_cal_done = False
        _enc_cal_auto_started = False
        _enc_step_initialized = -1
        _cal_delta_M1 = _cal_delta_M2 = _cal_delta_M3 = _cal_delta_M4 = None
        # Print first step info
        first = AUTO_SEQUENCE[0]
        if isinstance(first[0], str):
            print(">>> 自动程序启动！步骤 1/%d: %s" %
                  (len(AUTO_SEQUENCE), first[0]))
        else:
            d0, Vx0, Vy0, w0 = first
            print(">>> 自动程序启动！步骤 1/%d: Vx=%d Vy=%d w=%d (%.1fs)" %
                  (len(AUTO_SEQUENCE), Vx0, Vy0, w0, d0))
    last_Plus = cur_Plus

    # --- 13. Dead zone + response curve + speed scaling ---
    Lx = apply_dead_zone(Lx)
    Ly = apply_dead_zone(Ly)
    Rx = apply_dead_zone(Rx)

    # WPILib 风格指数曲线: 低速细腻、高速爆发
    Lx = apply_response_curve(Lx, JOYSTICK_EXPO)
    Ly = apply_response_curve(Ly, JOYSTICK_EXPO)
    Rx = apply_response_curve(Rx, OMEGA_EXPO)

    Vx = Lx * SPEED_SCALE
    Vy = Ly * SPEED_SCALE
    omega = Rx * SPEED_SCALE

    # --- 14. Direction calibration ---
    if INVERT_VX:
        Vx = -Vx
    if INVERT_VY:
        Vy = -Vy
    if INVERT_OMEGA:
        omega = -omega

    # --- 14b. Face flip: 反面时前后左右全部取反 ---
    if face_flipped:
        Vx = -Vx
        Vy = -Vy

    # --- 15. Kinematics ---
    M1_power, M2_power, M3_power, M4_power = mecanum_kinematics(Vx, Vy, omega)

    # --- 15b. 起步助推：0→非0 瞬间加力克服静摩擦 ---
    M1_power, M2_power, M3_power, M4_power = startup_burst(
        M1_power, M2_power, M3_power, M4_power, novapi.timer())

    # --- 16. Output to chassis motors ---
    __motor_M1.set_power(M1_power)
    __motor_M2.set_power(M2_power)
    __motor_M3.set_power(M3_power)
    __motor_M4.set_power(M4_power)

    # --- 17. LED display ---
    if not (_debug_cal_done and novapi.timer() < _cal_display_until):
        __led.show("S%d" % BL_ACTION_SPEED)

    # --- 18. Loop delay ---
    time.sleep(LOOP_DELAY)
