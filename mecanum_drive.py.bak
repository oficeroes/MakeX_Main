"""
Mecanum 4WD Robot — Remote Control Program
============================================
Novapi-based X-type mecanum wheel chassis remote control.
  Left stick  → omnidirectional movement
  Right stick → in-place rotation
  Both sticks can be used simultaneously (e.g. strafe + rotate).

Hardware:
  Chassis — Encoder motor x4 (X-type mecanum layout)
    - M1 (front-left)  — normal wiring
    - M2 (front-right) — reversed wiring
    - M3 (rear-left)   — normal wiring
    - M4 (rear-right)  — reversed wiring
  Actuators —
    - DC1/DC2/DC3 — DC motors (ball collector), power expand board
    - M5 — Encoder motor (ball roller)
    - BL1/BL2 — Brushless motors, power expand board
    - SV1/SV2 — Smart servos, M6 port chain (INDEX1/INDEX2)

Controls:
  Left stick  ↑↓  = forward/back (指数曲线, 低速细腻)
  Left stick  ←→  = strafe left/right
  Right stick ←→  = rotate left/right (独立曲线指数)
  N1          — both servos fire (BL must be on first)
  N2          — M5=-100 + DC2=+100
  N4          — M5=+100 + DC2=-100
  N3          — unused
  D-pad ↑↓   — BL speed ±5 (range 10~100)
  D-pad ←     — DC3 oscillate -100↔+100 toggle
  D-pad →     — unused
  R2          — BL1+BL2 both on/off
  L1          — face flip toggle (swap front/back)
  L2          — unused
  R1          — unused
  Menu (≡)    — debug mode toggle
  +           — start auto program (AUTO_SEQUENCE)

X-type Mecanum Kinematics:
            Forward (+Vy)
                ^
         M1 <--+--> M2    (FL M1, FR M2)
                |
         M3 <--+--> M4    (RL M3, RR M4)

  Standard inverse kinematics (all wheels forward = positive rotation):
    M1_raw =  Vx + Vy + omega
    M2_raw = -Vx + Vy - omega
    M3_raw = -Vx + Vy + omega
    M4_raw =  Vx + Vy - omega

  M2, M4 reversed wiring correction:
    M2_out = -( -Vx + Vy - omega) =  Vx - Vy + omega
    M4_out = -(  Vx + Vy - omega) = -Vx - Vy + omega

  Vector scaling: if any |power| > 100, scale all 4 proportionally.
"""
import novapi
import time
from mbuild import gamepad
from mbuild import power_expand_board
from mbuild.encoder_motor import encoder_motor_class
from mbuild.led_matrix import led_matrix_class

# ---- Smart servo: optional, robot may not have this hardware ----
try:
    from mbuild.smartservo import smartservo_class
    _HAS_SERVO = True
except ImportError:
    _HAS_SERVO = False
    smartservo_class = None

# ==================== Configuration ====================
SPEED_SCALE = 0.85       # 最大功率倍率 (摇杆推满 = 85%)
DEAD_ZONE = 0            # 摇杆死区 (|值| < 8 → 0)
CURVE_LIFT = 20          # 曲线最低输出%: 摇杆一推就有此值 (0=关闭, 建议10~20)
MIN_MOTOR_POWER = 10     # 电机安全兜底 (应 < CURVE_LIFT×SPEED_SCALE, 否则无效)
LOOP_DELAY = 0.02        # 主循环间隔 (秒)
JOYSTICK_EXPO = 2.0      # 摇杆指数曲线: 1.0=线性, 1.3=柔顺, 2.0=二次 (越小低速越灵敏)
OMEGA_EXPO = 2.0         # 旋转摇杆独立曲线指数 (通常与平移一致, 可单独调)

INVERT_VX = False
INVERT_VY = True
INVERT_OMEGA = True

# 前后重量补偿：尾重头轻 → 前轮 (M1/M2) 加力、后轮 (M3/M4) 减力
# 范围 0.0 ~ 0.50，0 = 不补偿。仅影响 Vy（直走/后退）分量。
# 写入时机：绘图程序导出时自动更新。
FRONT_BACK_COMPENSATION = 0.0000

# 旋转均衡补偿：尾重导致旋转时前后轮出力不均 → 前轮 omega 加力
# 范围 0.0 ~ 0.50，0 = 不补偿。仅影响 omega（旋转）分量。
# 独立于前后补偿，因为旋转力学与直走不同。
# 写入时机：绘图程序导出时自动更新。
ROTATION_BALANCE = 0.0000

# 平移纵向耦合补偿：尾重导致平移时向前漂移 → 根据 |Vx| 自动减 Vy
# 范围 0.0 ~ 0.30，0 = 不补偿。值越大反向拉回越强。
# 公式：Vy = Vy - |Vx| × 此值（仅当 |Vx| > |Vy| 时生效，即主要在做平移）
# 写入时机：绘图程序导出时自动更新。
STRAFE_VY_COUPLING = 0.0000

# 起步助推：功率从零→非零的瞬间，短暂额外加力克服静摩擦。
# 只在"刚启动"起作用，持续 STARTUP_BURST_MS 后自动退出。不读传感器 → 零延迟。
STARTUP_BURST_ENABLE = True   # 总开关 (False=关闭)
STARTUP_BURST_PCT = 30        # 起步时额外增加功率% (叠加在运动学输出上)
STARTUP_BURST_MS = 150        # 助推持续时间 (毫秒)

# DC collector motors
DC_COLLECTOR_PORT1 = "DC1"
DC_COLLECTOR_PORT2 = "DC2"
DC_COLLECTOR_PORT3 = "DC3"
DC_COLLECTOR_SPEED = 100

# M5 roller motor
ROLLER_SPEED = 80

# Servo fire action (L1=SV1, R1=SV2)
BL_ACTION_SPEED = 80
BL_SPINUP_DELAY = 0.1
SERVO1_ACTION_ANGLE = -40
SERVO2_ACTION_ANGLE = 40
SERVO_ACTION_SPEED = 50
SERVO_RETURN_DELAY = 0.14

# 8x16 LED matrix (landscape: 16col x 8row)
LED_PORT = "PORT2"
LED_INDEX = "INDEX1"

# Debug mode
DEBUG_TEST_SPEED = 50
DEBUG_SERVO_ANGLE = 90
SERVO_MOVE_SPEED = 30
DEBUG_MOTOR_TYPES = ["Motor", "DC", "BLDC", "Servo"]
DEBUG_MOTOR_NAMES = ["M1", "M2", "M3", "M4", "M5"]
DEBUG_DC_NAMES = ["DC1", "DC2"]
DEBUG_BLDC_NAMES = ["BL1", "BL2"]
DEBUG_SERVO_NAMES = ["SV1", "SV2"]
DEBUG_ALL_NAMES = [DEBUG_MOTOR_NAMES, DEBUG_DC_NAMES, DEBUG_BLDC_NAMES, DEBUG_SERVO_NAMES]

# ==================== Auto Program ====================
AUTO_SPEED = 50
AUTO_STEP_DELAY = 0.02
AUTO_RAMP_MS = 0
AUTO_ACCEL_MS = 0               # ms: within-step 0→100→0 acceleration ramp

# ==================== Debug Calibration ====================
DEBUG_CAL_POWER    = 50    # forward power % for encoder calibration in debug mode
DEBUG_CAL_DURATION = 1.0   # seconds to drive during calibration
DEBUG_CAL_ACCEL_MS = 250   # ms ramp-up/down (same shape as AUTO_ACCEL_MS)
AUTO_SEQUENCE = [
    # === Auto-generated by trajectory_planner on 2026-07-06 23:02 ===
    # Source: (encoder calibration)  |  Format: v4-time
    # Mode: translation | speed: 30.0 cm/s | power: 50
    ('encoder_cal', 1.0, 0, 50, 0),
    ( 0.10,    0,    0,    0),
]

# ==================== Hardware Init ====================
__motor_M1 = encoder_motor_class("M1", "INDEX1")
__motor_M2 = encoder_motor_class("M2", "INDEX1")
__motor_M3 = encoder_motor_class("M3", "INDEX1")
__motor_M4 = encoder_motor_class("M4", "INDEX1")
__motor_M5 = encoder_motor_class("M5", "INDEX1")
__led = led_matrix_class(LED_PORT, LED_INDEX)

if _HAS_SERVO:
    try:
        __servo_1 = smartservo_class("M6", "INDEX1")
        __servo_2 = smartservo_class("M6", "INDEX2")
    except Exception:
        _HAS_SERVO = False

# ==================== Kinematics ====================
def mecanum_kinematics(Vx, Vy, omega):
    # 平移纵向耦合补偿：尾重 → 平移时向前漂移，按 |Vx| 比例减 Vy 拉回
    sc = STRAFE_VY_COUPLING
    if sc > 0.001 and abs(Vx) > abs(Vy) and abs(Vx) > 0.5:
        Vy = Vy - abs(Vx) * sc

    M1 =  Vx + Vy + omega
    M2 = -Vx + Vy - omega
    M3 = -Vx + Vy + omega
    M4 =  Vx + Vy - omega

    M2 = -M2
    M4 = -M4

    # 前后重量补偿：尾重头轻 → 前轮 (M1/M2) 加力、后轮 (M3/M4) 减力
    fb = FRONT_BACK_COMPENSATION
    if fb > 0.001:
        front_gain = 1.0 + fb
        rear_gain = 1.0 - fb
        M1 *= front_gain
        M2 *= front_gain
        M3 *= rear_gain
        M4 *= rear_gain

    # 旋转均衡补偿：尾重 → 旋转时前后出力不均
    rb = ROTATION_BALANCE
    if rb > 0.001:
        # 后乘方式会影响已混合的 Vx/Vy/omega，与 fb 同理
        # 旋转均衡独立于前后补偿，对调前后轮的 omega 贡献
        rot_front = 1.0 + rb
        rot_rear  = 1.0 - rb
        M1 *= rot_front
        M2 *= rot_front
        M3 *= rot_rear
        M4 *= rot_rear

    max_abs = max(abs(M1), abs(M2), abs(M3), abs(M4))
    if max_abs > 100:
        scale = 100.0 / max_abs
        M1 *= scale
        M2 *= scale
        M3 *= scale
        M4 *= scale

    # 最小功率托底：防止低速时个别轮子因负载太重转不动
    M1 = apply_min_power(M1)
    M2 = apply_min_power(M2)
    M3 = apply_min_power(M3)
    M4 = apply_min_power(M4)

    return M1, M2, M3, M4


def apply_dead_zone(value, threshold=DEAD_ZONE):
    if abs(value) < threshold:
        return 0
    return value


def apply_min_power(power):
    """电机最小功率托底：功率太低电机转不动 → 强制提升到 MIN_MOTOR_POWER。

    0 值保持不动（静止轮子不强制启动）。
    仅当 0 < |power| < MIN_MOTOR_POWER 时才提升。
    """
    if MIN_MOTOR_POWER <= 0:
        return power
    if 0 < power < MIN_MOTOR_POWER:
        return MIN_MOTOR_POWER
    if -MIN_MOTOR_POWER < power < 0:
        return -MIN_MOTOR_POWER
    return power


def startup_burst(m1_pwr, m2_pwr, m3_pwr, m4_pwr, now):
    """起步瞬间助推：检测 0→非0 跳变 → 短暂加力克服静摩擦。

    只在功率从零变非零的瞬间触发，持续 STARTUP_BURST_MS 后自动退出。
    不读速度传感器 → 零延迟。
    返回调整后的 (m1_pwr, m2_pwr, m3_pwr, m4_pwr)。
    """
    global _burst_until, _last_nonzero

    if not STARTUP_BURST_ENABLE:
        return m1_pwr, m2_pwr, m3_pwr, m4_pwr

    powers = [m1_pwr, m2_pwr, m3_pwr, m4_pwr]
    adjusted = list(powers)
    burst_end = now + STARTUP_BURST_MS / 1000.0

    for i in range(4):
        is_running = abs(powers[i]) > 0

        if is_running and not _last_nonzero[i]:
            # 0 → 非0 跳变：启动助推计时器
            _burst_until[i] = burst_end

        _last_nonzero[i] = is_running

        if now < _burst_until[i] and abs(powers[i]) > 0:
            # 助推生效中：在运动学功率上叠加
            sign = 1 if powers[i] >= 0 else -1
            boosted = abs(powers[i]) + STARTUP_BURST_PCT
            adjusted[i] = sign * min(100, boosted)

    return tuple(adjusted)


def apply_response_curve(value, exponent=JOYSTICK_EXPO, max_input=100.0):
    """带抬升的指数响应曲线。

    纯指数:  output = (|v|/100)^expo × 100
    抬升后:  output = L + (100-L) × (|v|/100)^expo
    其中 L = CURVE_LIFT，确保摇杆一推就有最低响应。

    示例 (exponent=2.0, L=15):
      摇杆 5%  → 15.2%  (一推就动)
      摇杆 20% → 18.4%
      摇杆 50% → 36.3%
      摇杆 100% → 100%  (满杆不变)
    """
    if value == 0:
        return 0.0
    sign = 1.0 if value > 0 else -1.0
    normalized = abs(value) / max_input
    curved = normalized ** exponent

    if CURVE_LIFT > 0:
        lift = CURVE_LIFT / max_input
        curved = lift + (1.0 - lift) * curved

    return sign * curved * max_input


def stop_all_motors():
    __motor_M1.set_power(0)
    __motor_M2.set_power(0)
    __motor_M3.set_power(0)
    __motor_M4.set_power(0)
    __motor_M5.set_power(0)
    power_expand_board.set_power(DC_COLLECTOR_PORT1, 0)
    power_expand_board.set_power(DC_COLLECTOR_PORT2, 0)
    power_expand_board.set_power(DC_COLLECTOR_PORT3, 0)
    power_expand_board.stop("BL1")
    power_expand_board.stop("BL2")
    if _HAS_SERVO:
        try:
            __servo_1.set_power(0)
            __servo_2.set_power(0)
        except Exception:
            pass


def debug_stop_motor():
    if debug_motor_type == 0:
        motor = [__motor_M1, __motor_M2, __motor_M3, __motor_M4, __motor_M5][debug_motor_index]
        motor.set_power(0)
    elif debug_motor_type == 1:
        port = [DC_COLLECTOR_PORT1, DC_COLLECTOR_PORT2][debug_motor_index]
        power_expand_board.set_power(port, 0)
    elif debug_motor_type == 2:
        port = ["BL1", "BL2"][debug_motor_index]
        power_expand_board.stop(port)
    else:
        if _HAS_SERVO:
            try:
                servo = [__servo_1, __servo_2][debug_motor_index]
                servo.set_power(0)
            except Exception:
                pass


